# Copy to .env: cp -n .env.example .env
#
# Keep secrets in .env.local instead - it is read AFTER this file, overrides it,
# is never committed, and `cp .env.example .env` cannot wipe it:
#     BOT_TOKEN=123456:ABC...
#     RUN_MODE=polling

# --- Telegram ---
BOT_TOKEN=123456:ABC-DEF_your_token_here
# Public HTTPS address of the service, no trailing slash. Empty -> no webhook is set.
WEBHOOK_URL=https://example.com
# Secret used in the webhook path and in the X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET=change-me-to-a-long-random-string
# webhook (production) | polling (local development)
RUN_MODE=webhook
# Local Bot API server (allows sending files up to 2 GB).
# Empty -> api.telegram.org is used, with its 50 MB limit.
TELEGRAM_API_BASE_URL=
# Group chat triggers (comma-separated): "@link <url>".
# A mention of the bot itself (@bot_name) always works and need not be listed.
GROUP_TRIGGERS=@link
# Drop updates accumulated while the bot was down.
# Empty -> auto: yes for webhook, no for polling.
DROP_PENDING_UPDATES=

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/video_bot.db
# DATABASE_URL=postgresql+asyncpg://bot:bot@postgres:5432/video_bot

# --- Redis (rate limiting; empty -> in-memory fallback) ---
REDIS_URL=
# REDIS_URL=redis://redis:6379/0

# --- Proxy (for platforms unreachable from the server network, e.g. TikTok) ---
# http://user:pass@host:port or socks5://host:port. Empty -> no proxy.
PROXY_URL=
# Comma-separated: which platforms go through the proxy. Empty -> all of them.
# PROXY_PLATFORMS=tiktok

# --- Limits ---
MAX_VIDEO_DURATION_SEC=600
MAX_FILE_SIZE_MB=50
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SEC=300
MAX_CONCURRENT_DOWNLOADS=4
DOWNLOAD_TIMEOUT_SEC=300

# --- Files / misc ---
TEMP_DIR=/tmp/video_bot
CLEANUP_INTERVAL_SEC=600
FILE_MAX_AGE_SEC=1800
LOG_LEVEL=INFO
# Log file (empty -> stdout only)
LOG_FILE=logs/bot.log
# Token for GET /stats (Authorization: Bearer <token>). Empty -> endpoint disabled.
STATS_TOKEN=
